# Copiez ce fichier en « .env » et renseignez vos valeurs.
# Ne committez JAMAIS le fichier .env (il est ignoré par git).

# --- Microsoft 365 / Microsoft Graph (flux applicatif "client credentials") ---
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=remplacez-par-votre-secret
# Boîte aux lettres à lire (adresse de la boîte qui reçoit les rapports)
GRAPH_MAILBOX=backups@mondomaine.fr
# Optionnel : ne lire qu'un dossier précis (sinon toute la boîte de réception)
# GRAPH_FOLDER=Inbox

# --- Comportement (optionnel, sinon valeurs par défaut / config.yaml) ---
# Source : "graph" (Microsoft 365) ou "demo" (mails d'exemple)
# BACKUPWATCH_SOURCE=graph
# Nombre d'heures analysées en arrière (16 h couvre la nuit)
# BACKUPWATCH_LOOKBACK_HOURS=16
# BACKUPWATCH_OUTPUT_DIR=output
