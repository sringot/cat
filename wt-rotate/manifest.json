{
  "manifest_version": 3,
  "name": "wt-rotate",
  "version": "1.0.0",
  "description": "Rotation automatique d'URLs pour affichage kiosk",
  "permissions": [
    "tabs",
    "storage",
    "windows",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "wt-rotate",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
